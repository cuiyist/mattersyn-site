n_status":"pending","general_background":[{"id":"hot-injection","title":"Injection and precursor supply","summary":"Rapid injection can concentrate precursor conversion near the start of a reaction, helping distinguish nucleation from subsequent growth. A short period of rapid precursor conversion can favour nucleation, while a later lower supply can favour growth on existing particles.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cr400544s","url":"https://doi.org/10.1021/cr400544s","kind":"review","title":"Mechanisms of Nucleation and Growth of Nanoparticles in Solution","container":"Chemical Reviews","year":2014}},{"id":"nonmetal-source","title":"Conversion of a nonmetal precursor","summary":"Chalcogen and pnictogen precursors can differ in how they release or transfer the element during a reaction. Bonding, coordination and the reaction medium can influence the activation or transfer steps that make an element available for growth.","label":"General background, not the authors' interpretation","reference":{"doi":"10.1021/cr900137k","url":"https://doi.org/10.1021/cr900137k","kind":"review","title":"Prospects of Colloidal Nanocrystals for Electronic and Optoelectronic Applications","container":"Chemical Reviews","year":2009}}]}
